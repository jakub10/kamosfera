# Skopíruj tento súbor ako `.env` a doplň hodnoty z Supabase (Project Settings → API).
# Pozor: všetko s prefixom VITE_ sa zabalí do JavaScriptu v prehliadači,
# takže sem patrí IBA verejný (anon / publishable) kľúč. Service-role kľúč nikdy.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Kde běží Kamosvět (repo jakub10/Kamosvet). Prázdné = dveře zůstanou zavřené.
VITE_KAMOSVET_URL=""
